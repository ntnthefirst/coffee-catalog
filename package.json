{
  "name": "dedica-coffee-catalog",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Coffee catalog for the De'Longhi Dedica Arte. Static site, styles written in SCSS.",
  "scripts": {
    "build": "sass --no-source-map --style=compressed scss/main.scss css/main.css",
    "watch": "sass --watch --no-source-map scss/main.scss css/main.css",
    "serve": "python3 -m http.server 8000",
    "test": "node tests/combinations.mjs"
  },
  "devDependencies": {
    "sass": "^1.80.0"
  }
}
